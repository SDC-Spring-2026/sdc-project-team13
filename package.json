{
  "name": "cache",
  "version": "0.1.0",
  "description": "Cache is a discord bot that helps with managing, leading, and contributing to SDC team projects.",
  "main": "./dist/index.js",
  "type": "commonjs",
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -c green,blue,magenta -n ESLint,BOT,WEB \"yarn dev:lint\" \"yarn dev:bot\" \"yarn dev:web\"",
    "dev:bot": "tsx --watch --env-file=.env ./src/index.ts",
    "dev:bot:once": "tsx --env-file=.env ./src/index.ts",
    "dev:web": "next dev ./apps/web",
    "dev:lint": "esw --watch ./src ./apps/web",
    "dev:setup": "tsx --env-file=.env ./src/setup.ts",
    "dev:register": "tsx --env-file=.env ./src/bot/registerCommands.ts",
    "lint": "eslint ./src ./apps/web",
    "style": "prettier . --write",
    "compile": "tsc",
    "build:web": "next build ./apps/web",
    "build": "yarn lint && yarn compile && yarn build:web",
    "start": "node --env-file=.env ./dist/index.js",
    "start:web": "next start ./apps/web",
    "setup": "node --env-file=.env ./dist/setup.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SDC-Spring-2026/sdc-project-team13.git"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "llm",
    "project",
    "management",
    "project",
    "tool",
    "pm"
  ],
  "author": "SDC Spring 2026 - Team 13",
  "contributors": [
    {
      "name": "Connor Furby",
      "email": "cfurby@wisc.edu"
    },
    {
      "name": "Cash Pergande",
      "email": "cash.pergande@gmail.com"
    },
    {
      "name": "Gavin Smith",
      "email": "me@gavinhsmith.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SDC-Spring-2026/sdc-project-team13/issues"
  },
  "homepage": "https://github.com/SDC-Spring-2026/sdc-project-team13#readme",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@eslint/markdown": "^7.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-watch": "^8.0.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@octokit/rest": "^22.0.1",
    "discord.js": "^14.23.2",
    "next": "^16.2.4",
    "octokit": "^5.0.4",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
